node_modules/
dist/
.env.local
dev-dist/

# Android / Capacitor build artifacts & signing secrets
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
*.keystore
*.jks
# Machine-specific: PKCS12 truststore built from the local Windows root store (see
# tools/regen-truststore.ps1). Contains this machine's CA certs — never commit it.
android/proxy-cacerts.p12
# Firebase config for push (per-project secret; keep out of source control).
android/app/google-services.json
# Firebase Admin SDK service-account key (server-side push secret) — never commit.
*firebase-adminsdk*.json
service-account*.json

# Playwright
test-results/
playwright-report/
.playwright/

# Supabase CLI local working state (project ref/pooler host cache, not secrets, but
# transient local metadata that doesn't belong in version control).
supabase/.temp/
