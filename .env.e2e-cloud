# Forces CLOUD mode for the write-failure Playwright suite (tests/e2e-cloud).
#
# The main suite runs demo mode (.env.test, empty vars => supabase === null), which means it
# cannot exercise a single Supabase write — the gap that let the 29 Jul 2026 job loss ship.
# These values are fake: nothing here ever reaches a real project. The specs intercept every
# request with page.route() and answer them locally.
VITE_SUPABASE_URL=https://e2e.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-anon-key-not-a-real-secret
