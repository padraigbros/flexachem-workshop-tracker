# Forces deterministic DEMO mode for the Playwright suite even when a real .env.local
# exists (empty string => supabase client is null => localStorage seed data + auto-admin).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Also neutralise a real DSN from .env.local: Vite loads .env.local in EVERY mode, and a
# mode file is the only thing that can override it. Without this the "Playwright suites stay
# offline" contract in src/lib/monitoring.js is silently false and every local test run
# reports to the production Sentry project.
VITE_SENTRY_DSN=
