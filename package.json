{
     "name": "flexachem-workshop",
     "private": true,
     "version": "0.0.1",
     "type": "module",
     "scripts": {
          "dev": "vite",
          "dev:test": "vite --mode test",
          "build": "vite build",
          "build:test": "vite build --mode test",
          "preview": "vite preview",
          "preview:test": "vite preview --mode test --port 5173 --strictPort",
          "test": "playwright test",
          "test:ui": "playwright test --ui",
          "build:e2e-cloud": "vite build --mode e2e-cloud --outDir dist-e2e-cloud",
          "preview:e2e-cloud": "vite preview --mode e2e-cloud --outDir dist-e2e-cloud --port 5174 --strictPort",
          "test:cloud": "playwright test --config=playwright.cloud.config.js",
          "build:android": "vite build && cap sync android",
          "apk": "npm run build:android && cd android && .\\gradlew assembleDebug",
          "apk:release": "npm run build:android && cd android && .\\gradlew assembleRelease",
          "aab": "npm run build:android && cd android && .\\gradlew bundleRelease",
          "open:android": "cap open android"
     },
     "dependencies": {
          "@capacitor/android": "^8.4.2",
          "@capacitor/app": "^8.1.1",
          "@capacitor/core": "^8.4.2",
          "@capacitor/haptics": "^8.0.2",
          "@capacitor/keyboard": "^8.0.5",
          "@capacitor/push-notifications": "^8.1.2",
          "@capacitor/splash-screen": "^8.0.2",
          "@capacitor/status-bar": "^8.0.3",
          "@dnd-kit/core": "^6.3.1",
          "@dnd-kit/sortable": "^10.0.0",
          "@dnd-kit/utilities": "^3.2.2",
          "@fontsource-variable/inter": "^5.2.8",
          "@fontsource-variable/jetbrains-mono": "^5.2.8",
          "@sentry/react": "^10.69.0",
          "@supabase/ssr": "^0.10.3",
          "@supabase/supabase-js": "^2.107.0",
          "cmdk": "^1.1.1",
          "lucide-react": "^1.25.0",
          "motion": "^12.42.2",
          "pdfjs-dist": "^6.1.200",
          "react": "^18.2.0",
          "react-dom": "^18.2.0",
          "react-router-dom": "^7.18.1",
          "sonner": "^2.0.7"
     },
     "devDependencies": {
          "@capacitor/assets": "^3.0.5",
          "@capacitor/cli": "^8.4.2",
          "@playwright/test": "^1.61.1",
          "@tailwindcss/vite": "^4.3.3",
          "@vitejs/plugin-react": "^4.0.0",
          "tailwindcss": "^4.3.3",
          "vite": "^6.0.0",
          "vite-plugin-pwa": "^1.3.0"
     }
}
