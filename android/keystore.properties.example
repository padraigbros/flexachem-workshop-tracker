# Copy this file to android/keystore.properties (git-ignored) and fill in real values.
# Create the keystore first (see BUILD_APK.md § "Release (signed) APK / AAB"):
#   keytool -genkeypair -v -keystore flexachem.keystore -alias flexachem \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android/app/. The default below points at a
# keystore kept at the repo root (which *.keystore already git-ignores).
storeFile=../../flexachem.keystore
storePassword=CHANGE_ME
keyAlias=flexachem
keyPassword=CHANGE_ME
